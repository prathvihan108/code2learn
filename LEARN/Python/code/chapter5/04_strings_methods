# ==============================================================================
# THE COMPLETE PYTHON STRING OPERATIONS CHEAT SHEET
# ==============================================================================

text = "  python programming is awesome!  "

# 1. CASE TRANSFORMATIONS
# ------------------------------------------------------------------------------
print(text.upper())        # "  PYTHON PROGRAMMING IS AWESOME!  " (All uppercase)
print(text.lower())        # "  python programming is awesome!  " (All lowercase)
print(text.title())        # "  Python Programming Is Awesome!  " (Capitalizes every word)
print(text.capitalize())   # "  python programming is awesome!  " (Capitalizes first letter only)


# 2. CLEANING & STRIPPING (Crucial for processing raw inputs)
# ------------------------------------------------------------------------------
# Removes whitespace (or specific characters) from the boundaries
print(text.strip())        # "python programming is awesome!" (Removes both sides)
print(text.lstrip())       # "python programming is awesome!  " (Left side only)
print(text.rstrip())       # "  python programming is awesome!" (Right side only)


# 3. SEARCHING, COUNTING & POSITIONING
# ------------------------------------------------------------------------------
sample = "hello world"

print(sample.count("l"))     # Output: 3 (Counts total occurrences of a substring)
print(sample.find("world"))  # Output: 6 (Returns starting index of the word)
print(sample.find("java"))   # Output: -1 (Returns -1 if the substring isn't found)

# Note: .index() does the same as .find(), but CRASHES with a ValueError if not found!
# print(sample.index("java")) 


# 4. SPLITTING & JOINING (The Data Tag-Team)
# ------------------------------------------------------------------------------
csv_data = "apple,banana,orange"

# .split(delimiter) breaks a string into a list of strings
fruits_list = csv_data.split(",") 
print(fruits_list)           # Output: ['apple', 'banana', 'orange']

# .join(iterable) merges a list of strings back into one string
joined_text = " - ".join(fruits_list)
print(joined_text)           # Output: "apple - banana - orange"


# 5. REPLACING & ALTERING
# ------------------------------------------------------------------------------
sentence = "I love Java"
new_sentence = sentence.replace("Java", "Python")
print(new_sentence)          # Output: "I love Python"


# 6. CONTENT VALIDATION / BOOLEAN CHECKS (Returns True or False)
# ------------------------------------------------------------------------------
filename = "report.pdf"
user_input = "12345"

# Checking boundaries:
print(filename.endswith(".pdf"))   # Output: True
print(filename.startswith("rep"))  # Output: True

# Checking character types:
print(user_input.isdigit())        # Output: True (Contains only numbers)
print("Python".isalpha())          # Output: True (Contains only alphabet letters)
print("Python3".isalnum())         # Output: True (Contains letters OR numbers, no spaces/symbols)
print("   ".isspace())             # Output: True (Contains only spaces/tabs/newlines)